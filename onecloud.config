# seed.config 玩客云 S805 meson8b openwrt‑24.10 arm32 musl
CONFIG_MODULES=y
CONFIG_HAVE_DOT_CONFIG=y
CONFIG_HOST_OS_LINUX=y

# ====================== 玩客云晶晨S805 meson8b 目标硬件 ======================
CONFIG_TARGET_amlogic=y
CONFIG_TARGET_amlogic_meson8b=y
CONFIG_TARGET_amlogic_meson8b_DEVICE_thunder-onecloud=y
CONFIG_TARGET_OPTIMIZATION="-O2 -pipe -mcpu=cortex-a5 -mfloat-abi=softfp"
CONFIG_TARGET_KERNEL_PARTSIZE=16
CONFIG_TARGET_BOOTFS_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=600
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_EMMCIMG=y
CONFIG_TARGET_IMAGES_GZIP=y

CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y
CONFIG_HAS_TESTING_KERNEL=y
CONFIG_HAS_FPU=y
CONFIG_MODVERSIONS=y
CONFIG_AUDIO_SUPPORT=y
CONFIG_GPIO_SUPPORT=y
CONFIG_PCI_SUPPORT=y
CONFIG_PCIE_SUPPORT=y
CONFIG_USB_SUPPORT=y
CONFIG_RTC_SUPPORT=y
CONFIG_USES_DEVICETREE=y
CONFIG_USES_INITRAMFS=y
CONFIG_USES_SQUASHFS=y
CONFIG_USES_EXT4=y
CONFIG_USES_TARGZ=y
CONFIG_USES_CPIOGZ=y
CONFIG_VIRTIO_SUPPORT=y
CONFIG_USES_ROOTFS_PART=y
CONFIG_USES_BOOT_PART=y

# ====================== 全局编译选项 加速/安全 ======================
# CONFIG_JSON_OVERVIEW_IMAGE_INFO is not set
CONFIG_SIGNED_PACKAGES=y
CONFIG_SIGNATURE_CHECK=y
CONFIG_DOWNLOAD_CHECK_CERTIFICATE=y
CONFIG_DISPLAY_SUPPORT=y
CONFIG_SHADOW_PASSWORDS=y
CONFIG_DEVEL=y
CONFIG_BROKEN=y
CONFIG_CCACHE=y
CONFIG_MOLD=y
CONFIG_IPV6=y
CONFIG_USE_SSTRIP=y
CONFIG_SSTRIP_DISCARD_TRAILING_ZEROES=y
CONFIG_PKG_CHECK_FORMAT_SECURITY=y
CONFIG_PKG_ASLR_PIE_REGULAR=y
CONFIG_PKG_CC_STACKPROTECTOR_REGULAR=y
CONFIG_KERNEL_STACKPROTECTOR=y
CONFIG_PKG_FORTIFY_SOURCE_1=y
CONFIG_PKG_RELRO_FULL=y
CONFIG_SECCOMP=y
CONFIG_USE_MUSL=y
CONFIG_SSP_SUPPORT=y
CONFIG_BINUTILS_VERSION_2_42=y
CONFIG_BINUTILS_VERSION="2.42"
CONFIG_GCC_VERSION="13.3.0"
CONFIG_GCC_USE_DEFAULT_VERSION=y
CONFIG_LIBC="musl"
CONFIG_TARGET_SUFFIX="musl"

# ====================== 内核配置 cgroup/zram/acl ======================
CONFIG_KERNEL_PRINTK=y
CONFIG_KERNEL_SWAP=y
# CONFIG_KERNEL_DEBUG_FS is not set
# CONFIG_KERNEL_KALLSYMS is not set
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_IPV6=y
CONFIG_USE_FS_ACL_ATTR=y
CONFIG_KERNEL_FS_POSIX_ACL=y
CONFIG_KERNEL_ZRAM=y
CONFIG_KERNEL_ZRAM_LZO=y
CONFIG_KERNEL_ZRAM_LZ4=y

# ====================== OpenWrt系统基础包 firewall4 nftables ======================
CONFIG_PACKAGE_base-files=y
CONFIG_PACKAGE_busybox=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_fstools=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_mountd=y
CONFIG_PACKAGE_logd=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_netifd=y
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_procd=y
CONFIG_PACKAGE_procd-ujail=y
CONFIG_PACKAGE_uci=y
CONFIG_PACKAGE_urandom-seed=y
CONFIG_PACKAGE_urngd=y
CONFIG_PACKAGE_usign=y

# DNS 【仅dnsmasq‑full，无原版dnsmasq，彻底避免冲突】
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_dnsmasq_full_tftp=y

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_irqbalance=y
# CONFIG_PACKAGE_jool-tools-netfilter is not set

# ====================== 文件系统内核模块 ======================
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-fuse=y
CONFIG_PACKAGE_kmod-fs-btrfs=y
CONFIG_PACKAGE_kmod-fs-ksmbd=y

# 字符集
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_kmod-nls-iso8859-1=y
CONFIG_PACKAGE_kmod-nls-utf8=y

# eMMC MMC 玩客云必选
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-block=y

# USB存储驱动（U盘刷写eMMC必备，移除无用USB1.1控制器）
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb2=y
# CONFIG_PACKAGE_kmod-usb-ohci is not set
# CONFIG_PACKAGE_kmod-usb-uhci is not set

# ====================== nft netfilter / fullcone 内核模块 ======================
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nf-nathelper=y
CONFIG_PACKAGE_kmod-nf-nathelper-extra=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y
CONFIG_PACKAGE_kmod-nf-conntrack-ftp=y
CONFIG_PACKAGE_kmod-nf-conntrack-tftp=y
CONFIG_PACKAGE_kmod-nf-nat-rtsp=y
# CONFIG_PACKAGE_kmod-nft-fullcone is not set
# CONFIG_PACKAGE_fullconenat-nft is not set
# CONFIG_PACKAGE_luci-app-fullconenat-nft is not set
# CONFIG_PACKAGE_luci-i18n-fullconenat-nft-zh-cn is not set
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# ====================== Luci中文+插件合集 ======================
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-lib-docker=y
CONFIG_PACKAGE_luci-app-poweroffdevice=y
CONFIG_PACKAGE_luci-app-mosdns=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_btrfs_progs=y
CONFIG_PACKAGE_luci-app-diskman_INCLUDE_lsblk=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-ttyd=y

# 中文翻译
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-poweroffdevice-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mosdns=y

# ====================== Docker容器 使用go版compose‑plugin替代python compose v1 ======================
CONFIG_PACKAGE_docker=y
# CONFIG_PACKAGE_docker-compose is not set
CONFIG_PACKAGE_docker-compose-plugin=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_containerd=y
CONFIG_PACKAGE_runc=y

# ====================== SMB KSMBD共享服务 ======================
CONFIG_PACKAGE_ksmbd-tools=y

# ====================== 【命令行刷eMMC全套完整工具】 ======================
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_sfdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_ntfs3progs=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_blockdev=y
CONFIG_PACKAGE_dd=y
CONFIG_PACKAGE_rng-tools=y
CONFIG_PACKAGE_block-extra=y
CONFIG_PACKAGE_hdparm=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_cfdisk=y
CONFIG_PACKAGE_fw-utils=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_gunzip=y
CONFIG_PACKAGE_pv=y
CONFIG_PACKAGE_file=y
CONFIG_PACKAGE_hexdump=y
CONFIG_PACKAGE_readelf=y
CONFIG_PACKAGE_mount-utils=y
CONFIG_PACKAGE_umount-utils=y

# ====================== 用户态工具、网络工具 ======================
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_wsdd2=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_xz=y
CONFIG_PACKAGE_p7zip=y
CONFIG_PACKAGE_cgi-io=y
CONFIG_PACKAGE_knot-host=y
CONFIG_PACKAGE_openssh-sftp-avahi-service=y
CONFIG_PACKAGE_openssh-sftp-server=y
# CONFIG_PACKAGE_ntpclient is not set
CONFIG_PACKAGE_chrony=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_zram-swap=y

CONFIG_PACKAGE_ubus=y
CONFIG_PACKAGE_libubus=y
CONFIG_PACKAGE_libubus-json=y
CONFIG_PACKAGE_ubusd=y

# ====================== Base system 完整基础包（OpenWrt 24.10） ======================
CONFIG_PACKAGE_libuci=y
CONFIG_PACKAGE_libubox=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_fwtool=y
CONFIG_PACKAGE_leds=y
CONFIG_PACKAGE_boardjson=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_rpcd-mod-luci=y
CONFIG_PACKAGE_rpcd-mod-rpcsys=y
CONFIG_PACKAGE_rpcd-mod-file=y
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iwinfo-data=y
CONFIG_PACKAGE_libiwinfo=y
CONFIG_PACKAGE_libiwinfo-data=y
CONFIG_PACKAGE_libjson-c=y
CONFIG_PACKAGE_libcurl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libpthread=y
CONFIG_PACKAGE_librt=y
CONFIG_PACKAGE_libzlib=y
CONFIG_PACKAGE_libbz2=y
CONFIG_PACKAGE_liblzma=y
CONFIG_PACKAGE_libzstd=y
CONFIG_PACKAGE_libncurses=y
CONFIG_PACKAGE_libreadline=y
CONFIG_PACKAGE_libelf=y
CONFIG_PACKAGE_libpcap=y
CONFIG_PACKAGE_libnl-tiny=y

CONFIG_PACKAGE_bridge=y
CONFIG_PACKAGE_swconfig=y
CONFIG_PACKAGE_kmod-gpio-button-hotplug=y
CONFIG_PACKAGE_hotplugd=y
CONFIG_PACKAGE_hotplug3=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_odhcp6c=y
