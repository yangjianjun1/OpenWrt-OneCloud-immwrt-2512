--- a/Makefile
+++ b/Makefile
@@ -30,8 +30,8 @@ GO_PKG:=github.com/docker/compose
 GO_PKG_LDFLAGS_X:= \
-	github.com/docker/compose.Version=$(PKG_VERSION) \
-	github.com/docker/compose.GitCommit=openwrt
+	github.com/docker/compose/v2.Version=$(PKG_VERSION) \
+	github.com/docker/compose/v2.GitCommit=immortalwrt-25.12

 include $(INCLUDE_DIR)/package.mk
 include $(TOPDIR)/feeds/packages/lang/golang/golang-package.mk
@@ -41,16 +41,29 @@ define Package/docker-compose/description
  Docker Compose plugin / standalone binary, go rewrite version
 endef

-define Build/Compile
-	$(call GoPackage/Build/Compile)
-endef
+define Build/Compile
+	( \
+		cd $(PKG_BUILD_DIR); \
+		GO111MODULE=on \
+		GOSUMDB=off \
+		GOPROXY=$(GO_MODULE_PROXY) \
+		CGO_ENABLED=0 \
+		$(GO_ENV) \
+		go build -mod=mod -trimpath \
+			-ldflags "$(GO_PKG_LDFLAGS) $(GO_PKG_LDFLAGS_X)" \
+			-o bin/compose ./cmd \
+	)
+endef

 define Package/docker-compose/install
-	$(INSTALL_DIR) $(1)/usr/bin
-	$(INSTALL_BIN) $(GO_PKG_BUILD_BIN_DIR)/docker-compose $(1)/usr/bin/
+	$(INSTALL_DIR) $(1)/usr/lib/docker/cli-plugins
+	$(INSTALL_BIN) $(PKG_BUILD_DIR)/bin/compose $(1)/usr/lib/docker/cli-plugins/docker-compose
+	$(INSTALL_DIR) $(1)/usr/bin
+	ln -sf /usr/lib/docker/cli-plugins/docker-compose $(1)/usr/bin/docker-compose
 endef

 $(eval $(call BuildPackage,docker-compose))
